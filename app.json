{
  "expo": {
    "name": "GitExplorer",
    "slug": "alymente_test",
    "version": "1.0.0",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#005f53"
    },
    "android": {
      "package": "com.gabrielbonin.alymente.test",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#005f53"
      }
    },
    "ios": {
      "edgeToEdgeEnabled": true,
      "bundleIdentifier": "com.gabrielbonin.alymente.test",
      "icon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#005f53"
        }
      ]
    ]
  }
}
